# URL backend Tangkas yang menyediakan konten site ini (tanpa trailing slash).
TANGKAS_API_URL=https://api.tangkas.sta.my.id

# Slug site di Tangkas yang kontennya dipakai (dashboard -> site -> slug).
SITE_SLUG=silabi

# Port HTTP server ini.
PORT=8746

# Seberapa sering konten di-refresh dari Tangkas (detik). Default 60.
CACHE_TTL_SECONDS=60
